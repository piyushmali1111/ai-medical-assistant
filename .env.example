# =====================================================================
# Google Gemini API Configuration
# =====================================================================
GOOGLE_API_KEY=your_gemini_api_key_here

# GEMINI_MODEL: Pick a current free-tier Flash model from the Gemini models page (e.g., gemini-2.5-flash or gemini-2.0-flash)
# Checked: October 2026
GEMINI_MODEL=gemini-2.5-flash

# =====================================================================
# LangSmith Tracing Configuration
# =====================================================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=ai-medical-assistant

# =====================================================================
# Embedding Model Configuration
# =====================================================================
# Provider: 'huggingface' (recommended, local, free, reproducible) or 'gemini'
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# =====================================================================
# Pipeline Parameters & Optimization Flags
# =====================================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5

# Gemini Free-Tier optimizations:
ENABLE_RELEVANCE_GRADER=true
ENABLE_SEPARATE_REASONING=true

# Rate Limiter (Requests Per Minute)
RPM_LIMIT=15
REQUEST_TIMEOUT=30

